# Every VITE_* value is bundled into browser code and must be safe to expose.
# Keep actual service-role keys, API secrets, and deployment identifiers out of this file.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY

# Public listing intake. The organizer form submits Berlin listings.
# Leaving it empty makes public listing submission fail closed.
VITE_N8N_EVENT_INTAKE_URL=

# Optional public token used by the logo lookup integration.
VITE_LOGO_DEV_TOKEN=

# Enable only after newsletter privacy review and server/provider setup.
VITE_NEWSLETTER_ENABLED=false
